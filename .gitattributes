# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf    
*.java text eol=lf
*.groovy text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.gradle.groovy text eol=lf
*.gradle.groovy.kts text eol=lf
*.gradle.groovy.kts text eol=lf